#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>

// Layer indices. Higher index wins when several layers are active.
#define L1     0
#define FKEYS  1
#define NUMPAD 2
#define LOWER  3
#define RAISE  4
#define ADJUST 5
#define QTILE  6

/ {
        conditional_layers {
                compatible = "zmk,conditional-layers";
                tri_layer {
                        if-layers = <LOWER RAISE>;
                        then-layer = <ADJUST>;
                };
        };

        behaviors {
                // Hold: Shift. Tap alone: Caps Lock.
                shift_caps: shift_caps {
                        compatible = "zmk,behavior-hold-tap";
                        #binding-cells = <2>;
                        flavor = "hold-preferred";
                        tapping-term-ms = <200>;
                        bindings = <&kp>, <&kp>;
                };
                // Left thumb LWR: hold = LOWER layer, tap then hold = QTILE layer.
                lwr_qtile: lwr_qtile {
                        compatible = "zmk,behavior-tap-dance";
                        #binding-cells = <0>;
                        tapping-term-ms = <200>;
                        bindings = <&mo LOWER>, <&mo QTILE>;
                };
                // Tap-dance on left thumb GUI: 1x hold/tap = LGUI, 2x hold/tap = LALT.
                gui_alt: gui_alt {
                        compatible = "zmk,behavior-tap-dance";
                        #binding-cells = <0>;
                        tapping-term-ms = <350>;
                        bindings = <&kp LGUI>, <&kp LALT>;
                };
                // Right thumb RSE: hold = RAISE layer, 2x tap = toggle NUMPAD layer.
                raise_num: raise_num {
                        compatible = "zmk,behavior-tap-dance";
                        #binding-cells = <0>;
                        tapping-term-ms = <200>;
                        bindings = <&mo RAISE>, <&tog NUMPAD>;
                };
        };

        // Latam has no plain ^ or ` key, only dead keys: tap them followed by space.
        macros {
                la_caret: la_caret {
                        compatible = "zmk,behavior-macro";
                        #binding-cells = <0>;
                        wait-ms = <20>;
                        tap-ms = <20>;
                        bindings
                                = <&macro_press &kp RALT>
                                , <&macro_tap &kp SQT>
                                , <&macro_release &kp RALT>
                                , <&macro_tap &kp SPACE>
                                ;
                };
                la_grave: la_grave {
                        compatible = "zmk,behavior-macro";
                        #binding-cells = <0>;
                        wait-ms = <20>;
                        tap-ms = <20>;
                        bindings
                                = <&macro_press &kp RALT>
                                , <&macro_tap &kp BSLH>
                                , <&macro_release &kp RALT>
                                , <&macro_tap &kp SPACE>
                                ;
                };
                // Holds RALT (AltGr) first, taps the key, then releases RALT so latam AltGr symbols (@, \, ~) never drop the modifier.
                la_altgr: la_altgr {
                        compatible = "zmk,behavior-macro-one-param";
                        #binding-cells = <1>;
                        wait-ms = <20>;
                        tap-ms = <20>;
                        bindings
                                = <&macro_press &kp RALT>
                                , <&macro_param_1to1>
                                , <&macro_tap &kp MACRO_PLACEHOLDER>
                                , <&macro_release &kp RALT>
                                ;
                };
                alt_tab: alt_tab {
                        compatible = "zmk,behavior-macro";
                        #binding-cells = <0>;
                        wait-ms = <0>;
                        tap-ms = <30>;
                        bindings
                                = <&macro_press &kp LALT>
                                , <&macro_tap &kp TAB>
                                , <&macro_pause_for_release>
                                , <&macro_release &kp LALT>
                                ;
                };
                // Holds LCTRL + LALT first, taps the given key, then releases LCTRL + LALT so VS Code / X11 always register both modifiers.
                ctrl_alt: ctrl_alt {
                        compatible = "zmk,behavior-macro-one-param";
                        #binding-cells = <1>;
                        wait-ms = <30>;
                        tap-ms = <30>;
                        bindings
                                = <&macro_press &kp LCTRL &kp LALT>
                                , <&macro_param_1to1>
                                , <&macro_tap &kp MACRO_PLACEHOLDER>
                                , <&macro_release &kp LCTRL &kp LALT>
                                ;
                };
        };

        keymap {
                compatible = "zmk,keymap";

                l1_layer {
// L1: Latin American base layout. Expects the OS keyboard layout set to latam.
// ACUT is the dead acute accent (tap it, then the vowel).
// -----------------------------------------------------------------------------------------
// |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
// | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  N~ | ACUT |
// | SFCP |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  -  | ESC  |
//                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |
// SFCP: hold = Shift, tap = Caps Lock. LWR: hold = LOWER, tap+hold = QTILE. RSE: hold = RAISE, 2x tap = NUMPAD.
                        bindings = <
   &kp TAB   &kp Q &kp W &kp E &kp R &kp T   &kp Y &kp U  &kp I     &kp O   &kp P    &kp BSPC
   &kp LCTRL &kp A &kp S &kp D &kp F &kp G   &kp H &kp J  &kp K     &kp L   &kp SEMI &kp LBKT
   &shift_caps LSHFT CAPS &kp Z &kp X &kp C &kp V &kp B   &kp N &kp M  &kp COMMA &kp DOT &kp FSLH &kp ESC
                  &gui_alt &lwr_qtile &kp SPACE   &kp RET &raise_num &kp RALT
                        >;
                display-name = "L1";
                };

                fkeys_layer {
// Function keys layer (replaces old US layer). Toggled with Lower + ACUT (FN).
// -----------------------------------------------------------------------------------------
// |  F1  |  F2 |  F3 |  F4 |  F5 |  F6 |   |  F7 |  F8 |  F9 | F10 | F11 | F12  |
// | CTRL | GUI | ALT | CTRL| SHFT|     |   | LFT | DWN |  UP | RGT | DEL |  FN  |
// | SHFT |     |     |     |     |     |   | HOME| PGDN| PGUP| END |     | ESC  |
//                    | GUI | LWR | SPC |   | ENT | RSE | ALT |
                        bindings = <
   &kp F1    &kp F2   &kp F3   &kp F4    &kp F5    &kp F6      &kp F7   &kp F8    &kp F9    &kp F10   &kp F11 &kp F12
   &kp LCTRL &kp LGUI &kp LALT &kp LCTRL &kp LSHFT &trans      &kp LEFT &kp DOWN  &kp UP    &kp RIGHT &kp DEL &tog FKEYS
   &kp LSHFT &trans   &trans   &trans    &trans    &trans      &kp HOME &kp PG_DN &kp PG_UP &kp END   &trans  &kp ESC
                               &gui_alt  &lwr_qtile &kp SPACE   &kp RET  &raise_num &kp RALT
                        >;
                display-name = "FKEYS";
                };

                numpad_layer {
// Num pad toggled with a double tap on RSE (double tap again to leave). Digits sit in the numpad
// arrangement starting at the U column; 0 is on the right thumb ALT key. Everything else falls through to L1.
// -----------------------------------------------------------------------------------------
// |      |     |     |     |     |     |   | PRTSC|  7  |  8  |  9  |     |      |
// |      |     |     |     |     |     |   |     |  4  |  5  |  6  |     |      |
// |      |     |     |     |     |     |   |     |  1  |  2  |  3  |     |      |
//                    |     |     |     |   |     |     |  0  |
                        bindings = <
   &trans &trans &trans &trans &trans &trans   &kp PSCRN &kp N7 &kp N8 &kp N9 &trans &trans
   &trans &trans &trans &trans &trans &trans   &trans &kp N4 &kp N5 &kp N6 &trans &trans
   &trans &trans &trans &trans &trans &trans   &trans &kp N1 &kp N2 &kp N3 &trans &trans
                         &trans &trans &trans   &trans &trans &kp N0
                        >;
                display-name = "NUMPAD";
                };

                lower_layer {
// Numbers and navigation. FN toggles FKEYS layer.
// Active while LWR is held.
// -----------------------------------------------------------------------------------------
// |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7   |  8   |  9  |  0  | BKSP |
// | CTRL | GUI | ALT | CTRL| SHFT|     |   | LFT | DWN  |  UP  | RGT | DEL |  FN  |
// | SHFT |     |     |     |     |     |   | HOME| PGDN | PGUP | END |     |      |
//                    | GUI | QTL | SPC |   | ENT |      | ALT  |
                        bindings = <
   &kp TAB   &kp N1   &kp N2   &kp N3    &kp N4    &kp N5      &kp N6   &kp N7    &kp N8    &kp N9    &kp N0  &kp BSPC
   &kp LCTRL &kp LGUI &kp LALT &kp LCTRL &kp LSHFT &trans      &kp LEFT &kp DOWN  &kp UP    &kp RIGHT &kp DEL &tog FKEYS
   &kp LSHFT &trans   &trans   &trans    &trans    &trans      &kp HOME &kp PG_DN &kp PG_UP &kp END   &trans  &trans
                               &gui_alt  &trans &kp SPACE   &kp RET  &trans    &kp RALT
                        >;
                display-name = "LOWER";
                };

                raise_layer {
// Symbols encoded for the latam OS layout.
// -----------------------------------------------------------------------------------------
// |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
// | CTRL |  '  |  "  |  /  |  ?  | INVQ|   |  -  |  =  |  [  |  ]  |  \  |  `   |
// | SHFT |  <  |  >  | INVE|  ;  |  :  |   |  _  |  +  |  {  |  }  | "|" |  ~   |
//                    | GUI |     | SPC |   | ENT |     | ALT |
// INVQ = inverted question mark, INVE = inverted exclamation mark.
                        bindings = <
   &kp TAB   &kp LS(N1) &la_altgr N2  &kp LS(N3)     &kp LS(N4)     &kp LS(N5)      &la_caret     &kp LS(N6) &kp LS(RBKT) &kp LS(N8)   &kp LS(N9)      &kp BSPC
   &kp LCTRL &kp MINUS  &kp LS(N2)    &kp LS(N7)     &kp LS(MINUS)  &kp EQUAL       &kp FSLH      &kp LS(N0) &kp LS(SQT)  &kp LS(BSLH) &la_altgr MINUS &la_grave
   &kp LSHFT &kp NUBS   &kp LS(NUBS)  &kp LS(EQUAL)  &kp LS(COMMA)  &kp LS(DOT)     &kp LS(FSLH)  &kp RBKT   &kp SQT      &kp BSLH     &kp GRAVE       &la_altgr RBKT
                                      &gui_alt       &trans         &kp SPACE       &kp RET       &trans     &kp RALT
                        >;
                display-name = "RAISE";
                };

                adjust_layer {
// Active when holding both LOWER and RAISE (via conditional_layers).
// -----------------------------------------------------------------------------------------
// |  F1  |  F2 |  F3 |  F4 |  F5 |  F6 |   |  F7 |  F8 |  F9 | F10 | F11 | F12  |
// | CTRL | GUI | ALT | CTRL| SHFT|     |   | RGB | EFF | HUI | SAI | BRI | SPI  |
// | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   |     | EFR | HUD | SAD | BRD | SPD  |
//                    | GUI |     | SPC |   | ENT |     | ALT |
                        bindings = <
   &kp F1     &kp F2       &kp F3       &kp F4       &kp F5       &kp F6         &kp F7          &kp F8          &kp F9          &kp F10         &kp F11         &kp F12
   &kp LCTRL  &kp LGUI     &kp LALT     &kp LCTRL    &kp LSHFT    &trans         &rgb_ug RGB_TOG &rgb_ug RGB_EFF &rgb_ug RGB_HUI &rgb_ug RGB_SAI &rgb_ug RGB_BRI &rgb_ug RGB_SPI
   &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4   &trans          &rgb_ug RGB_EFR &rgb_ug RGB_HUD &rgb_ug RGB_SAD &rgb_ug RGB_BRD &rgb_ug RGB_SPD
                                        &gui_alt     &trans       &kp SPACE      &kp RET         &trans          &kp RALT
                        >;
                display-name = "ADJUST";
                };

                qtile_layer {
// Activated via tap-then-hold on LWR. Sends GUI+number for Qtile groups.
// Hold SHFT on the left pinky while tapping a group to move the focused window (GUI+Shift+N).
// -----------------------------------------------------------------------------------------
// | ATAB | WS1 | WS2  | WS3  | WS4 | WS5 |   | WS6 | WS7  | WS8  | WS9  | WS0 | BKSP |
// | CTRL |     | C+A+S| C+A+D|     |     |   | GLFT| GDWN | GUP  | GRGT |     |      |
// | SHFT |     |      |      |     |     |   |     |      |      |      |     |      |
//                    | GUI |     | SPC |   | ENT |      | ALT  |
                        bindings = <
   &alt_tab  &kp LG(N1) &kp LG(N2)  &kp LG(N3)  &kp LG(N4) &kp LG(N5)   &kp LG(N6)   &kp LG(N7)   &kp LG(N8) &kp LG(N9)    &kp LG(N0) &kp BSPC
   &kp LCTRL &trans     &ctrl_alt S &ctrl_alt D &trans     &trans       &kp LG(LEFT) &kp LG(DOWN) &kp LG(UP) &kp LG(RIGHT) &trans     &trans
   &kp LSHFT &trans     &trans      &trans      &trans     &trans       &trans       &trans       &trans     &trans        &trans     &trans
                                    &gui_alt    &trans     &kp SPACE    &kp RET      &trans       &kp RALT
                        >;
                display-name = "QTILE";
                };

        extra2 { status = "reserved"; };

        extra3 { status = "reserved"; };

        extra4 { status = "reserved"; };

        extra5 { status = "reserved"; };
        };
};
